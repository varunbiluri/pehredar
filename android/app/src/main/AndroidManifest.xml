<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Pehredar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Requires the CALL_SCREENING role (requested at runtime via
          RoleManager in MainActivity) before the system will route calls
          here. Silently rings (does not block) calls from numbers not in
          the user's contacts, if the user has opted into that in Settings.
          Live AI conversation during calls is not implemented and is not
          planned: Android reserves raw call audio access (CAPTURE_AUDIO_OUTPUT)
          to privileged system apps, so a third-party app cannot legitimately
          answer and speak during a real call. See README "Why no live AI
          conversation" for the full explanation and what was tried.
        -->
        <service
            android:name=".PehredarCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
